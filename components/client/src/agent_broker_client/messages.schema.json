{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_broker/messages",
  "$defs": {
    "SessionState": {
      "enum": [
        "idle",
        "working",
        "stopped"
      ]
    },
    "Language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "ISO 639-1 code, for example en or pl"
    },
    "ContainerState": {
      "enum": [
        "running",
        "exited",
        "restarting",
        "paused",
        "created",
        "dead",
        "missing"
      ],
      "description": "The Docker state of the container of an agent. missing: no container exists."
    },
    "AgentState": {
      "enum": [
        "ok",
        "unreachable"
      ],
      "description": "ok: the agent answers its API."
    },
    "UtcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$",
      "description": "ISO 8601 date and time in UTC, for example 2026-11-16T10:00:00Z"
    },
    "CommandRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Made by the client. A repeated ID runs nothing."
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "voice",
            "text"
          ],
          "default": "text"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "CommandAccepted": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "accepted",
            "duplicate"
          ]
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    },
    "ConfigSetRequest": {
      "type": "object",
      "properties": {
        "value": {}
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "ConfigValue": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Dotted path, for example claude.permission_mode"
        },
        "value": {}
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": false
    },
    "ConfigValues": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfigValue"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    },
    "ConfigSetResult": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {},
        "applied": {
          "enum": [
            "now",
            "at_restart"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "applied"
      ],
      "additionalProperties": false
    },
    "AgentList": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "enum": [
                  "agent_api",
                  "opencode"
                ]
              },
              "container_state": {
                "$ref": "#/$defs/ContainerState"
              },
              "agent_state": {
                "$ref": "#/$defs/AgentState"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "provider",
              "container_state",
              "agent_state",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "agents"
      ],
      "additionalProperties": false
    },
    "AgentResult": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "container_state": {
          "$ref": "#/$defs/ContainerState"
        }
      },
      "required": [
        "agent",
        "container_state"
      ],
      "additionalProperties": false
    },
    "AgentStatus": {
      "type": "object",
      "properties": {
        "uptime_s": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "string"
        },
        "open_sessions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "uptime_s",
        "version",
        "open_sessions"
      ],
      "additionalProperties": false
    },
    "SessionCreateRequest": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1,
          "description": "Client ID"
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the workspace root of the agent"
        },
        "force": {
          "type": "boolean",
          "default": false,
          "description": "Create a workspace folder that does not exist"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "A model ID of the agent (GET /models)"
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "description": "An effort of the agent (GET /efforts). Without it: the default effort of the agent"
        },
        "tools": {
          "$ref": "#/$defs/ToolPolicy",
          "description": "Without it: each tool of the agent. Fixed for the life of the session"
        }
      },
      "required": [
        "client",
        "workspace",
        "model"
      ],
      "additionalProperties": false
    },
    "ToolPolicy": {
      "type": "object",
      "description": "The tools of a session. Tool names of the agent. allow null: each tool of the agent. deny wins over allow.",
      "properties": {
        "allow": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          ]
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "allow",
        "deny"
      ],
      "additionalProperties": false
    },
    "SessionSettingsRequest": {
      "type": "object",
      "description": "A change of the model or the effort of one session",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "ModelList": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "default": {
          "type": "string",
          "minLength": 1,
          "description": "DEFAULT_MODEL of the agent: the starting value of a client"
        }
      },
      "required": [
        "models",
        "default"
      ],
      "additionalProperties": false
    },
    "EffortList": {
      "type": "object",
      "properties": {
        "efforts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "default": {
          "type": "string",
          "minLength": 1,
          "description": "DEFAULT_EFFORT of the agent: the effort of a session that gives none"
        }
      },
      "required": [
        "efforts",
        "default"
      ],
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "type": [
            "string",
            "null"
          ],
          "description": "Client ID. Null for a session that another tool made."
        },
        "workspace": {
          "type": "string",
          "description": "Relative form, for example x"
        },
        "workspace_path": {
          "type": "string",
          "description": "The path that the agent uses"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Null if the session has no title."
        },
        "created_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "last_modified": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "$ref": "#/$defs/ToolPolicy"
        }
      },
      "required": [
        "id",
        "agent",
        "client",
        "workspace",
        "workspace_path",
        "state",
        "title",
        "created_at",
        "last_modified",
        "model",
        "effort",
        "tools"
      ],
      "additionalProperties": false
    },
    "SessionList": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Session"
          }
        }
      },
      "required": [
        "sessions"
      ],
      "additionalProperties": false
    },
    "SessionResult": {
      "type": "object",
      "properties": {
        "session_state": {
          "$ref": "#/$defs/SessionState"
        }
      },
      "required": [
        "session_state"
      ],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "bad_request",
            "unauthorized",
            "not_found",
            "busy",
            "workspace_not_found",
            "agent_unavailable",
            "invalid_setting",
            "unsupported_tools"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "error",
        "message"
      ],
      "additionalProperties": false
    },
    "StateEvent": {
      "description": "State event of the broker API. The broker adds the field agent; it is required.",
      "$ref": "#/$defs/AgentApiStateEvent",
      "required": [
        "agent"
      ]
    },
    "StatusEvent": {
      "description": "Status event of the broker API. The broker adds the field agent; it is required.",
      "$ref": "#/$defs/AgentApiStatusEvent",
      "required": [
        "agent"
      ]
    },
    "ReplyEvent": {
      "description": "Reply event of the broker API. The broker adds the field agent; it is required.",
      "$ref": "#/$defs/AgentApiReplyEvent",
      "required": [
        "agent"
      ]
    },
    "NoticeEvent": {
      "description": "Notice event of the broker API. The broker adds the field agent; it is required.",
      "$ref": "#/$defs/AgentApiNoticeEvent",
      "required": [
        "agent"
      ]
    },
    "LogEvent": {
      "description": "Log event of the broker API. The broker adds the field agent; it is required.",
      "$ref": "#/$defs/AgentApiLogEvent",
      "required": [
        "agent"
      ]
    },
    "AgentApiStateEvent": {
      "description": "State event of the agent API (a session stream). The field agent is optional.",
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the agent. Optional in the agent API: the broker writes it."
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "description": "Session ID"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        }
      },
      "required": [
        "session",
        "state"
      ],
      "additionalProperties": false
    },
    "AgentApiStatusEvent": {
      "description": "Status event of the agent API (a session stream). The field agent is optional.",
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the agent. Optional in the agent API: the broker writes it."
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "description": "Session ID"
        },
        "kind": {
          "enum": [
            "activity"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "session",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "AgentApiReplyEvent": {
      "description": "Reply event of the agent API (a session stream). The field agent is optional.",
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the agent. Optional in the agent API: the broker writes it."
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "description": "Session ID"
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/Language"
        }
      },
      "required": [
        "session",
        "command_id",
        "message",
        "language"
      ],
      "additionalProperties": false
    },
    "AgentApiNoticeEvent": {
      "description": "Notice event of the agent API (a session stream or the agent stream). The field agent is optional.",
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the agent. Optional in the agent API: the broker writes it."
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "description": "Session ID. Absent in an event of the agent stream or the broker stream."
        },
        "kind": {
          "enum": [
            "lifecycle",
            "command_failed",
            "command_dropped"
          ]
        },
        "command_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "command_id",
        "text"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "command_failed",
              "command_dropped"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "session"
        ]
      }
    },
    "AgentApiLogEvent": {
      "description": "Log event of the agent API (the agent stream). The field agent is optional.",
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the agent. Optional in the agent API: the broker writes it."
        },
        "component": {
          "type": "string"
        },
        "level": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO",
            "DEBUG"
          ]
        },
        "time": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "level",
        "time",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
